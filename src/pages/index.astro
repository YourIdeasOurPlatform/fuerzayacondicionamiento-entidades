---
import PortalApp from '../components/PortalApp';
import '../styles/portal.css';
---

<html lang="es" data-athletic-studio="true">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#c81e2a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Fuerza y Acondicionamiento" />
    <link rel="icon" type="image/jpeg" href="/FAP.jpg" />
    <link rel="apple-touch-icon" href="/FAP-circle.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    />
    <title>Fuerza y Acondicionamiento</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme') || localStorage.getItem('portal-theme');
          var useDark = stored === 'light' ? false : true;
          document.documentElement.classList.toggle('dark', useDark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <PortalApp client:load />
  </body>
</html>
